{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": ["**", "!pnpm-lock.yaml", "!dist"]
  },
  "formatter": { "indentStyle": "space", "indentWidth": 2 },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "none",
      "nursery": { "noFloatingPromises": "error" },
      "suspicious": { "noTsIgnore": "error", "noFocusedTests": "error" }
    }
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "plugins": [
    {
      "path": "./biome-plugins/no-stage-branching.grit",
      "includes": ["**", "!**/*.test.ts", "!test/**"]
    },
    "./biome-plugins/no-coerce-boolean.grit"
  ]
}
