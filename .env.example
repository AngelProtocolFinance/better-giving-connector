# Copy to .env.local for `pnpm dev`. Deployed values live in the Vercel project's environment variables only.

# This service's own origin, no path: https://app.connect.better.giving deployed, http://localhost:<port> locally
PUBLIC_URL=
# libsql://<db>.turso.io from `turso db show --url <db>`, or file:local.db for a local database (refused when VERCEL is set)
TURSO_DATABASE_URL=
# `turso db tokens create <db>`; required unless TURSO_DATABASE_URL is a file: URL
TURSO_AUTH_TOKEN=
# signs better-auth sessions and OAuth state, 32+ characters: `openssl rand -base64 32`
BETTER_AUTH_SECRET=
# encrypts each connection's deployment key at rest, 32+ characters: `openssl rand -base64 32`; changing it leaves every stored key undecryptable
CONNECTION_KEY_SECRET=
# Vercel sends it as `Authorization: Bearer <CRON_SECRET>` when it runs the vercel.json crons; locally, send that header to GET /cron/sweep yourself. 32+ characters: `openssl rand -base64 32`
CRON_SECRET=
