# Every variable the app reads (src/env.ts). Deployed, each is set in the
# Vercel project (Settings > Environment Variables) scoped to Production only,
# the token and secrets as Sensitive, then redeployed. Locally, copy this file
# to .env.local (gitignored) and fill it in. This file is committed and the
# repo is public: placeholders only, never a real value.

# The origin Claude and ChatGPT reach: the OAuth issuer and the connector URL.
# https://connect.better.giving in production; the dev server's origin locally.
PUBLIC_URL=http://localhost:8787

# Turso database holding the connection rows and auth tables.
# Deployed: `turso db show <db> --url`. Locally: a file, e.g. file:local.db.
TURSO_DATABASE_URL=file:local.db
# `turso db tokens create <db> --expiration never` (read-write); a file: URL needs none.
TURSO_AUTH_TOKEN=

# Generate each with `openssl rand -base64 32`, a different value per environment.
# better-auth's signing secret for sessions and OAuth tokens.
BETTER_AUTH_SECRET=replace-with-better-auth-secret
# Encrypts each deployment's key at rest; 32 random bytes, base64. Changing it
# makes every stored key unreadable, so each connection must reconnect.
CONNECTION_KEY_SECRET=replace-with-connection-key-secret
