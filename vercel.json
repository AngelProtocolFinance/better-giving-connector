{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "hono",
  "buildCommand": "pnpm run db:migrate && pnpm run build",
  "outputDirectory": "dist",
  "regions": ["iad1"],
  "fluid": true,
  "crons": [
    {
      "path": "/cron/sweep",
      "schedule": "23 4 * * *"
    }
  ],
  "ignoreCommand": "[ \"$VERCEL_ENV\" != production ]"
}
